{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance",
  "version": "0.1.0",
  "identifier": "app.resonance.player",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx serve public -p 5173",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Resonance",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "Local-first intelligent music player",
    "longDescription": "Resonance is a local-first music player and automix engine with privacy-respecting intelligence."
  },
  "plugins": {}
}
